      payload.brazo_der_cm ? Number(payload.brazo_der_cm) : '',
      payload.muslo_izq_cm ? Number(payload.muslo_izq_cm) : '',
      payload.muslo_der_cm ? Number(payload.muslo_der_cm) : '',
